        "SELECT * FROM workspace.default.v_county_basis_risk ORDER BY miss_rate DESC, false_alarm_rate DESC"
      ]
    },
    {
      "name": "premium",
      "displayName": "premium",
      "queryLines": [
        "SELECT * FROM workspace.default.v_county_premium ORDER BY premium_per_acre_usd DESC"
