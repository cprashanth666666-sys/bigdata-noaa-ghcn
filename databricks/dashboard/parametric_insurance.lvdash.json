                      "name": "crop",
                      "expression": "`crop`"
                    }
                  ],
                  "disaggregated": false
                }
              },
              {
                "name": "f_crop_premium",
                "query": {
                  "datasetName": "premium",
                  "fields": [
                    {
                      "name": "crop",
                      "expression": "`crop`"
                    }
